      "book": "burning-city",
      "major": true,
      "default": "glimpsed",
      "note": "Chapter 2: how much of the village saw him in the fire"
    },
    "b1.prisoner": {
      "kind": "enum",
      "values": [
        "village",
        "killed",
        "fed"
      ],
      "book": "burning-city",
      "major": true,
      "default": "village",
      "note": "Chapter 2: what he did with the captured torchman"
    },
    "b1.farewell": {
      "kind": "enum",
      "values": [
        "promise",
        "truth",
        "silent"
      ],
      "book": "burning-city",
      "major": true,
      "default": "promise",
      "note": "Chapter 2: what he said to Aelia"
    },
    "quick_start": {
      "kind": "flag",
      "note": "Set when a book was begun with a quick start (default history)"
    },
    "et.door": {
      "kind": "enum",
      "values": [
        "left",
        "right"
      ],
      "book": "engine-test",
      "major": true,
      "default": "left",
      "note": "Developer test: the door taken in the engine test"
    },
    "et.hill": {
      "kind": "enum",
      "values": [
        "climbed",
        "stayed"
      ],
      "book": "engine-test-d",
      "major": true,
      "default": "climbed",
      "note": "Developer test: what the sample chapter did at the hill"
    },
    "et.mark": {
      "kind": "flag",
      "book": "engine-test-d",
      "note": "Developer test: set on one branch of the sample chapter"
    }
  }
}
