{
  "note": "The flag registry: every story variable that is not a declared stat (stats.json), a person field (<id>.name, .gender, .alias, .surname from people.json), or a scratch variable starting with an underscore. kind is flag (true or unset), enum (one of values), number, or text. book is where it is decided. major: true records it in the decision log for journals and callbacks. default is the value a quick start uses when it skips that book. A name ending in .* covers a family of variables. npm run check rejects variables that are not registered, so misspellings are caught.",
  "flags": {
    "hero.origin": {
      "kind": "enum",
      "values": "@origins",
      "book": "burning-city",
      "note": "Homeland, chosen at creation"
    },
    "hero.role": {
      "kind": "enum",
      "values": "@roles",
      "book": "burning-city",
      "note": "Mortal role, chosen at creation"
    },
    "hero.path": {
      "kind": "enum",
      "values": "@paths",
      "book": "burning-city",
      "note": "How the hero came to Rome"
    },
    "hero.look.*": {
      "kind": "text",
      "book": "burning-city",
      "note": "Appearance chosen at creation: height, build, age, hair, eyes, skin, mark"
    },
    "hero.death": {
      "kind": "enum",
      "values": [
        "arena",
        "execution",
        "fever"
      ],
      "book": "burning-city",
      "default": "fever",
      "note": "Set by the prologue"
    },
    "prologue.day": {
      "kind": "enum",
      "values": [
        "children",
        "fields",
        "boundary"
      ],
      "book": "burning-city",
      "major": true,
      "default": "children",
      "note": "Prologue choice"
    },
    "prologue.stand": {
      "kind": "enum",
      "values": [
        "paid",
        "stood",
        "looked_away"
      ],
      "book": "burning-city",
      "major": true,
      "default": "looked_away",
      "note": "Prologue choice"
    },
    "prologue.answer": {
      "kind": "enum",
      "values": [
        "yes",
        "asked",
        "refused"
      ],
      "book": "burning-city",
      "major": true,
      "default": "yes",
      "note": "Prologue choice"
    },
    "b1.tablet": {
      "kind": "enum",
      "values": [
        "keep",
        "scrape"
      ],
      "book": "burning-city",
      "major": true,
      "default": "keep",
      "note": "Chapter 1: what he did with the tablet in the villa"
    },
    "b1.first_blood": {
      "kind": "enum",
      "values": [
        "animal",
        "forced",
        "drained",
        "killed"
      ],
      "book": "burning-city",
      "major": true,
      "default": "animal",
      "note": "Chapter 1: how he first fed"
    },
    "b1.collector": {
      "kind": "enum",
      "values": [
        "unmet",
        "spared",
        "drained",
        "fled",
        "killed"
      ],
      "book": "burning-city",
      "major": true,
      "default": "unmet",
      "note": "Chapter 1: the tax collector's man at the crossroads"
    },
    "b1.goat": {
      "kind": "enum",
      "values": [
        "freed",
        "tied"
      ],
      "book": "burning-city",
      "default": "tied",
      "note": "Chapter 1: the boy's goat"
    },
    "b1.warning": {
      "kind": "enum",
      "values": [
        "none",
        "followed",
        "warned"
      ],
      "book": "burning-city",
      "major": true,
      "default": "none",
      "note": "Chapter 1: what he did about the strangers in the wood"
    },
    "b1.reveal": {
      "kind": "enum",
      "values": [
        "none",
        "aelia",
        "spouse"
      ],
      "book": "burning-city",
      "major": true,
      "default": "none",
      "note": "Chapter 2: who in the family saw him before the fire"
    },
    "b1.spouse_told": {
      "kind": "enum",
      "values": [
        "none",
        "truth",
        "lie",
        "silence"
      ],
      "book": "burning-city",
      "default": "none",
      "note": "Chapter 2: what he told his spouse, if he showed himself"
    },
    "b1.spouse_fire": {
      "kind": "enum",
      "values": [
        "went_in",
        "held_back"
      ],
      "book": "burning-city",
      "major": true,
      "default": "went_in",
      "note": "Chapter 2: whether he went into the burning house"
    },
    "b1.saw_marks": {
      "kind": "flag",
      "book": "burning-city",
      "major": true,
